# Общие настройки автоматического ИИ-ревью.
# Редактируется без изменения workflow-файла и скриптов.

# --- Настройки курса ---

# Название учебного курса. Подставляется в промпт вместо {{COURSE_NAME}}
# (см. common-footer.md). При переносе системы на другой предмет достаточно
# поменять эту строку и содержимое tasks/** — остальной движок предметно
# независим.
COURSE_NAME="Языковые процессоры интеллектуальных систем"

# Файлы в корне репозитория, где описаны общие требования курса. Модель
# сверяется с ними при ревью. Подставляется вместо {{COURSE_DOCS}}.
#
# ВНИМАНИЕ: файл читается через `source`, поэтому значения — обычные строки
# в ДВОЙНЫХ кавычках без обратных кавычек (`) и без $(...): они будут
# выполнены как команда. Пишите просто: "TASK.md и README.md".
COURSE_DOCS="TASK.md (требования практикума) и README.md (вариант студента)"

# Провайдер/модель в формате provider/model. Ключ соответствующего провайдера
# должен быть добавлен как organization secret (./manage.sh set-secret <ИМЯ>).
# Workflow при запуске проверяет наличие нужного ключа и подсказывает, какой
# именно секрет требуется.
#
#   openrouter/... -> OPENROUTER_API_KEY   groq/... -> GROQ_API_KEY
#   google/...     -> GEMINI_API_KEY
#
# ВЫБОР ПРОВАЙДЕРА ДЛЯ БЕСПЛАТНОГО ТАРИФА (замерено на реальном промпте):
#
# Наш промпт — около 9,5 КБ, это ~6000-9000 токенов (кириллица токенизируется
# хуже ASCII). Агент работает итеративно: читает файлы, получает результаты
# инструментов, отвечает — 3-8 запросов, каждый несёт всю историю. Итого
# 20-60 тысяч токенов на одно ревью.
#
#   OpenRouter free: лимиты по ЗАПРОСАМ (20/мин, 50/сутки без пополнения),
#     ограничения по токенам нет -> для нашей задачи подходит.
#     ВАЖНО: на бесплатных моделях провайдеры могут обучаться на промптах,
#     а в промпт попадает код студентов. Отключите обучение:
#     https://openrouter.ai/settings/privacy
#
#   Groq free: TPM всего 8000 у ВСЕХ моделей с tool calling -> первый же
#     запрос упирается в лимит, ревью будет постоянно падать с 429.
#     Бесплатный тариф Groq для этой задачи практически неприменим.
#
#   Groq платно: ~$0.005 за ревью (gpt-oss-120b). Пополнение на $5 покрывает
#     ~1000 ревью, снимает лимит TPM и вопрос обучения на данных. Если есть
#     возможность потратить $5 — это лучший вариант по совокупности.
#
MODEL="openrouter/nvidia/nemotron-3-super-120b-a12b:free"

# Проверенные альтернативы (закомментированы):
# MODEL="openrouter/nvidia/nemotron-3.5-lightning:free"   # контекст 1M
# MODEL="openrouter/google/gemma-4-31b-it:free"           # компактнее
# MODEL="groq/openai/gpt-oss-120b"                        # платный Groq

# --- Защита от избыточного количества запусков (см. lib/rate-limit.sh) ---
#
# ВАЖНО про бюджет GitHub Actions. Организация курса на плане Free получает
# 2000 минут в месяц НА ВСЮ ОРГАНИЗАЦИЮ (для приватных репозиториев), а не на
# репозиторий. При этом лимиты ниже применяются в каждом репозитории студента
# отдельно: получить общий счётчик по группе нельзя — из репозитория студента
# не видно историю чужих репозиториев.
#
# Поэтому лимиты рассчитаны консервативно, "снизу". Ориентир на группу из 20
# студентов при среднем прогоне ревью ~3 минуты:
#   20 студентов × 5 PR за семестр × 2 ревью × 3 мин ≈ 600 минут.
# Запас нужен на неудачные прогоны и на сборку студенческих проектов в
# check.sh (лабы 3-5 запускают build.sh с таймаутом до 3 минут).
#
# Следите за расходом: Organization settings → Billing → Actions. Если минуты
# заканчиваются к концу семестра — снижайте MAX_REVIEWS_PER_PR до 1.
# Переход на GitHub Education / Teacher benefits даёт план Team (3000 минут)
# и, что важнее, branch protection для приватных репозиториев.

# Максимум ОПУБЛИКОВАННЫХ ревью на один PR. Отказы по cooldown и лимитам в
# этот счётчик не входят (см. lib/rate-limit.sh), поэтому значение означает
# ровно "сколько раз студент получит комментарий бота в одном PR".
MAX_REVIEWS_PER_PR=2

# Максимум запусков workflow в сутки в ОДНОМ репозитории студента. Защищает
# от того, что один студент за день сожжёт заметную долю общих минут
# организации и дневную квоту бесплатного API модели.
MAX_REVIEWS_PER_DAY=6

# Минимальный интервал в минутах между двумя запусками ревью для одного PR
# (защита от серии быстрых push подряд).
COOLDOWN_MINUTES=15

# Максимальное суммарное количество изменённых строк (added+deleted) в рабочей
# директории студента, при превышении которого ИИ-ревью пропускается (см.
# lib/diff-guard.sh). Защищает от прогона огромного diff (например, лабы №5
# со сгенерированным кодом) через лимитированный бесплатный API.
#
# Значение выбрано по фактической статистике 60 PR прошлого года
# (репозиторий yapis-2025, медиана PR = 704 строки, среднее = 1361):
#
#   лимит 1500 -> пропущено 28% PR   (слишком строго: режет обычные лабы 4-5)
#   лимит 3000 -> пропущено 15% PR   <- выбрано
#   лимит 5000 -> пропущено  8% PR
#   лимит 8000 -> пропущено  1% PR
#
# 3000 — компромисс: большие лабы 5 с полным компилятором уходят на ручное
# ревью (это и правильно), а типовые работы проверяются автоматически.
# Если упираетесь в лимиты API — снижайте; если ревью нужно почти всегда —
# поднимайте до 5000. Промпт всё равно обрезает diff до 1200 строк
# (MAX_DIFF_LINES_IN_PROMPT в lib/build-prompt.sh), так что рост этого
# значения увеличивает не размер запроса, а лишь долю проверяемых PR.
MAX_DIFF_LINES=3000
