# Общие настройки автоматического ИИ-ревью.
# Редактируется без изменения скриптов ревьюера.
#
# ВНИМАНИЕ: файл читается через `source`, поэтому значения — обычные строки
# в ДВОЙНЫХ кавычках без обратных кавычек (`) и без $(...): они будут
# выполнены как команда. Пишите просто: "TASK.md и README.md".

# --- Настройки курса ---

# Название учебного курса. Подставляется в промпт вместо {{COURSE_NAME}}
# (см. common-footer.md). При переносе системы на другой предмет достаточно
# поменять эту строку и содержимое tasks/** — остальной движок предметно
# независим.
COURSE_NAME="Языковые процессоры интеллектуальных систем"

# Файлы в корне репозитория студента, где описаны общие требования курса.
# Модель сверяется с ними при ревью. Подставляется вместо {{COURSE_DOCS}}.
COURSE_DOCS="TASK.md (требования практикума) и README.md (вариант студента)"

# --- Назначение преподавателя ревьюером PR ---
#
# Кто из преподавателей ведёт какую группу. Открытый PR студента
# автоматически получает review request на своего преподавателя, чтобы
# работа не потерялась и попадала в его личный список "Review requests".
# См. reviewer/lib/assign-reviewers.sh.
#
# Формат: пары <группа>:<логин GitHub>, через пробел. Группа — та часть
# имени репозитория, что идёт после REPO_PREFIX
# (yapis-2026-321701-ivanov -> 321701).
#
# ПОЧЕМУ НЕ CODEOWNERS. Файл .github/CODEOWNERS был бы штатным способом,
# но на плане Free для ПРИВАТНЫХ репозиториев автоматический review request
# по нему не работает: файл принимается без ошибок
# (GET /repos/{o}/{r}/codeowners/errors отдаёт пустой список), однако при
# открытии PR ревьюер не запрашивается. Проверено экспериментально на
# отдельном репозитории организации. Поэтому назначение делает ревьюер.
#
# Логин преподавателя должен иметь доступ к репозиториям студентов (у нас
# оба преподавателя — админы, их добавляет enroll/create), иначе GitHub
# отклонит запрос ревью. Список всех преподавателей для команд doctor и
# audit задаётся отдельно — TEACHERS в admin/.env.
TEACHER_BY_GROUP="321701:rserdyukov 321702:rserdyukov 321703:kvetkod"

# Преподаватель по умолчанию. Используется в двух случаях:
#   - группа есть в имени репозитория, но её нет в TEACHER_BY_GROUP;
#   - группы в имени нет вовсе (yapis-2026-ivanov) — схема курса с одним
#     преподавателем.
# Пустое значение — не назначать никого (в логе останется предупреждение).
# Если преподаватель один, заполните только эту строку, а TEACHER_BY_GROUP
# можно не трогать.
TEACHER_DEFAULT=""

# --- Модель ---
#
# Модель в формате openrouter/<автор>/<модель>. Курс работает с ОДНИМ
# провайдером — OpenRouter, его ключ хранится единственным секретом
# OPENROUTER_API_KEY в приватном репозитории ревьюера
# (./manage.sh set-secret OPENROUTER_API_KEY).
#
# Сменить провайдера одной строкой здесь нельзя: ревьюер проверяет префикс
# openrouter/ и упадёт с понятной ошибкой. Если провайдер всё же нужно
# поменять, правьте reviewer/lib/review-pr.sh, workflow ревьюера и doctor.
#
# СТОИМОСТЬ (замерено на реальном промпте):
#
# Наш промпт — около 10 КБ, это ~6000-9000 токенов (кириллица токенизируется
# хуже ASCII). Агент работает итеративно: читает файлы, получает результаты
# инструментов, отвечает — 3-8 запросов, каждый несёт всю историю. Итого
# одно ревью ≈ 50-80K входных токенов и ~2K выходных.
#
# Gemma 4 31B платная: $0.09/M вход, $0.34/M выход -> около $0.01 за ревью,
# ~$2 за семестр на 200 ревью. Баланс: ./manage.sh stats или
# https://openrouter.ai/settings/credits. Лимитов по запросам у платных
# моделей нет, доступность обеспечивают ~14 провайдеров.
#
# ПОЧЕМУ НЕ :free. Бесплатные эндпоинты (gemma-4-31b-it:free, laguna и др.)
# делят один upstream-лимит на всех пользователей OpenRouter и в рабочее
# время отвечают 429 «temporarily rate-limited upstream» — проверено
# 16.09.2026: 0 из 9 запросов прошли. Каждый такой сбой превращался бы в
# комментарий «техническая ошибка» студенту. Плюс на :free провайдеры могут
# обучаться на промптах, а туда попадает код студентов.
#
# Gemma 4 31B — dense instruct-модель без режима рассуждений по умолчанию:
# отвечает сразу итогом, хорошо держит русский язык и формат ответа.
MODEL="openrouter/google/gemma-4-31b-it"

# ПОЧЕМУ НЕ nemotron-3-super-120b (модель курса до сентября 2026): это
# reasoning-модель, и в PR yapis-2026-321702-puchinskaya#1 она вывела
# вместо ревью 50 КБ английских рассуждений «Let's check…», а затем
# зациклилась на повторе символа. Теперь такой ответ отсекается
# (REVIEW_MAX_BYTES и др. ниже), но reasoning-модели для этой задачи
# нежелательны в принципе — часть ревью будет уходить в брак.
#
# Альтернативы (закомментированы). Перед переключением прогоните
# .github/review/tests/eval-prompts.sh --repeat 3.
# MODEL="openrouter/google/gemma-4-26b-a4b-it"            # MoE 26B-A4B, дешевле и быстрее, чуть слабее
# MODEL="openrouter/poolside/laguna-s-2.1"                # coding-agent 118B-A8B, хорош с инструментами
# MODEL="openrouter/google/gemma-4-31b-it:free"           # та же модель, но 429 в часы пик

# --- Контроль качества ответа модели (см. validate_review_text в common.sh) ---
#
# Бесплатные модели иногда выдают вместо ревью брак: ход рассуждений на
# английском, зацикливание на одном символе, десятки килобайт текста.
# Такой ответ НЕ публикуется — вместо него студент видит сообщение о
# технической ошибке, а ревью можно повторить: ./manage.sh review <repo>:<pr> --force.
# Ноль отключает соответствующую проверку.

# Максимальный размер ответа в байтах. Нормальное ревью — 2-6 КБ.
REVIEW_MAX_BYTES=15000

# Минимальная доля кириллицы среди букв (в процентах). Код и пути в
# ревью дают латиницу, поэтому 100% не бывает; нормальное русское ревью
# с кодом — 70-90%, английские рассуждения — около 10%.
REVIEW_MIN_CYR_PCT=60

# Максимальный повтор одного символа подряд (признак зацикливания).
REVIEW_MAX_REPEAT=200

# --- Лимиты (см. reviewer/lib/discover.sh) ---
#
# Ревью выполняется централизованно: один workflow в приватном репозитории
# преподавателя по расписанию обходит все репозитории организации. Поэтому
# лимиты считаются ГЛОБАЛЬНО, по фактически опубликованным комментариям
# бота во всех PR — а не отдельно в каждом репозитории, как раньше.
#
# Бюджет GitHub Actions при этом расходуется из аккаунта, где лежит
# репозиторий ревьюера (личный аккаунт на Free: 2000 минут/месяц). Ориентир
# для группы из 20 студентов при среднем ревью ~3 минуты:
#   20 студентов × 5 PR × 2 ревью × 3 мин ≈ 600 минут за семестр
#   + обход по расписанию каждые 10 минут ≈ 144 × ~0.5 мин ≈ 70 мин/сутки.
# Следите за расходом: ./manage.sh stats.

# Максимум ОПУБЛИКОВАННЫХ ревью на один PR. Отказы (лимиты, большой PR) в
# счётчик не входят: значение означает ровно "сколько раз студент получит
# комментарий с ревью в одном PR".
MAX_REVIEWS_PER_PR=2

# Максимум ревью в сутки в ОДНОМ репозитории студента. Защищает от того,
# что один студент за день съест дневную квоту бесплатного API модели.
MAX_REVIEWS_PER_DAY=4

# Максимум ревью в сутки на ВСЕ репозитории курса. Должен быть меньше
# дневного лимита провайдера с запасом на повторы (OpenRouter free: 50
# запросов/сутки, одно ревью — 3-8 запросов).
MAX_REVIEWS_PER_DAY_TOTAL=12

# Сколько PR максимум проверять за один запуск ревьюера. Один PR — одна
# матричная job (~3 мин); при значении 4 запуск укладывается в ~5 минут.
MAX_REVIEWS_PER_RUN=4

# Максимальное суммарное количество изменённых строк (added+deleted) в PR,
# при превышении которого ИИ-ревью пропускается. Защищает от прогона
# огромного diff (например, лабы №5 со сгенерированным кодом) через
# лимитированный бесплатный API.
#
# Значение выбрано по фактической статистике 60 PR прошлого года
# (репозиторий yapis-2025, медиана PR = 704 строки, среднее = 1361):
#
#   лимит 1500 -> пропущено 28% PR   (слишком строго: режет обычные лабы 4-5)
#   лимит 3000 -> пропущено 15% PR   <- выбрано
#   лимит 5000 -> пропущено  8% PR
#   лимит 8000 -> пропущено  1% PR
#
# Промпт всё равно обрезает diff до 1200 строк (MAX_DIFF_LINES_IN_PROMPT в
# lib/build-prompt.sh), так что рост этого значения увеличивает не размер
# запроса, а лишь долю проверяемых PR.
MAX_DIFF_LINES=3000

# --- Изолированный запуск check.sh (см. reviewer/lib/run-check.sh) ---
#
# check.sh для лаб 3-5 запускает compile.sh студента — недоверенный код.
# В ревьюере он исполняется в контейнере без сети, с ограничением памяти,
# CPU и времени. Образ собирается из reviewer/Dockerfile и публикуется в
# GitHub Container Registry аккаунта ревьюера (reviewer/workflow/
# build-check-image.yml).
CHECK_TIMEOUT_SECONDS=300
CHECK_MEMORY_LIMIT="1g"
CHECK_CPU_LIMIT="1.0"
