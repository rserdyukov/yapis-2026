# Тексты всех сообщений, которые бот ревьюера оставляет в Pull Request.
#
# Файл вынесен отдельно, чтобы менять формулировки, не трогая логику в
# скриптах ревьюера (reviewer/lib/*.sh). Правится преподавателем под стиль
# своего курса.
#
# ─────────────────────────────────────────────────────────────────────────
# ПРАВИЛА РЕДАКТИРОВАНИЯ (важно)
#
# 1. Файл читается через `source`, то есть это обычный bash-синтаксис:
#      - значения в ДВОЙНЫХ кавычках;
#      - НЕ используйте обратные кавычки ` и $(...) — они будут выполнены
#        как команда. Для кода в тексте применяйте одинарные кавычки '...'
#        либо экранируйте: \`code\`;
#      - символ " внутри текста экранируйте: \"
#
# 2. Подстановки вида ${MAX_REVIEWS_PER_DAY} работают: значения берутся из
#    config.env. Доступные плейсхолдеры указаны у каждого сообщения.
#    Если убрать плейсхолдер из текста — ничего не сломается.
#
# 3. Перенос строки внутри сообщения — через \n (сообщения печатаются
#    через printf '%b').
#
# 4. Маркеры MARKER_* не редактируйте: по ним ревьюер находит свои
#    комментарии в PR, отличает выполненные ревью от отказов и понимает,
#    какой коммит уже проверен.
#
# После правки: bash -n .github/review/messages.env
# Раскатать: ./manage.sh sync-reviewer
# ─────────────────────────────────────────────────────────────────────────


# --- Служебные маркеры (не редактировать) --------------------------------

# Помечает все комментарии бота.
MARKER_REVIEW="<!-- ai-review-marker -->"

# Помечает комментарии-отказы (лимиты, слишком большой PR). Позволяет
# отличать их от выполненных ревью независимо от текста сообщения.
MARKER_SKIPPED="<!-- ai-review-skipped -->"

# Помечает сообщение о технической ошибке.
MARKER_FAILED="<!-- ai-review-marker-failed -->"

# Префикс маркера с SHA проверенного коммита: "<!-- ai-review-sha:abc123 -->".
# По нему ревьюер понимает, что для этого коммита комментарий уже оставлен,
# и не проверяет его повторно.
MARKER_SHA_PREFIX="<!-- ai-review-sha:"


# --- Заголовки -----------------------------------------------------------

# Заголовок успешного ревью. Плейсхолдеры: ${TASK_NUM} — номер лабораторной,
# ${SHORT_SHA} — короткий SHA проверенного коммита.
MSG_REVIEW_HEADER="## 🤖 Автоматическое ИИ-ревью (лабораторная работа №\${TASK_NUM}, коммит \${SHORT_SHA})"

# Дисклеймер под заголовком успешного ревью.
MSG_REVIEW_DISCLAIMER="> Это предварительная автоматическая проверка. Финальное решение по работе принимает преподаватель."

# Первая строка любого сообщения об отказе. Ниже неё подставляется
# конкретная причина из MSG_LIMIT_* или MSG_DIFF_TOO_BIG.
#
# Оформляется как GitHub alert — жёлтый блок с иконкой, чтобы отказ было
# видно в ленте комментариев. Доступные типы: NOTE (синий), TIP (зелёный),
# IMPORTANT (фиолетовый), WARNING (жёлтый), CAUTION (красный).
MSG_SKIPPED_ALERT_TYPE="WARNING"
MSG_SKIPPED_HEADER="🤖 Автоматическое ИИ-ревью пропущено."


# --- Причины отказа: лимиты ----------------------------------------------

# Исчерпан дневной лимит ревью на репозиторий студента.
# Плейсхолдер: ${MAX_REVIEWS_PER_DAY}
MSG_LIMIT_DAILY="достигнут дневной лимит автоматических ревью для этого репозитория (\${MAX_REVIEWS_PER_DAY}/сутки). Это защищает от превышения бесплатных лимитов API модели. Попробуйте завтра либо запросите ревью у преподавателя."

# Исчерпан лимит ревью на один PR.
# Плейсхолдер: ${MAX_REVIEWS_PER_PR}
MSG_LIMIT_PER_PR="для этого PR уже опубликовано максимальное количество автоматических ревью (\${MAX_REVIEWS_PER_PR}). Дальнейшая проверка — вручную преподавателем."

# Исчерпан общий дневной лимит на весь курс (все репозитории).
# Плейсхолдер: ${MAX_REVIEWS_PER_DAY_TOTAL}
MSG_LIMIT_GLOBAL="на сегодня исчерпан общий лимит автоматических ревью курса (\${MAX_REVIEWS_PER_DAY_TOTAL}). Ваш PR будет проверен при следующем запуске, когда лимит обновится."


# --- Размер PR --------------------------------------------------------------

# Причина отказа по размеру. Сейчас НЕ используется: большой PR не
# отвергается, а проверяется в сокращённом режиме (см. MSG_OVERSIZE_NOTE).
# Оставлено для совместимости и на случай, если режим захочется вернуть.
# Плейсхолдеры: ${CHANGED_LINES} — сколько строк изменено,
#               ${MAX_DIFF_LINES} — лимит.
MSG_DIFF_TOO_BIG="PR слишком большой для автоматического ИИ-ревью: изменено строк \${CHANGED_LINES}, лимит \${MAX_DIFF_LINES}. Такой объём изменений стоит смотреть преподавателю вручную."

# Пометка в шапке ревью, выполненного в сокращённом режиме (PR больше
# MAX_DIFF_LINES без учёта сгенерированных файлов). Печатается одной строкой
# внутри blockquote под дисклеймером, поэтому без переносов.
# Плейсхолдеры: ${CHANGED_LINES}, ${MAX_DIFF_LINES}.
MSG_OVERSIZE_NOTE="⚠️ **Сокращённый режим:** в PR изменено \${CHANGED_LINES} строк (лимит полного ревью — \${MAX_DIFF_LINES}, сгенерированные файлы не считаются). Проверены запуск compile.sh/сборка грамматики и структура работы; анализ исходного кода пропущен — его проведёт преподаватель."


# --- Прочие сообщения -----------------------------------------------------

# Сбой при выполнении ревью (недоступен API модели, нет ключа и т.п.).
# Оформлено как alert CAUTION (красный): требуется вмешательство преподавателя.
MSG_TECH_ERROR="> [!CAUTION]\n> 🤖 **Автоматическое ИИ-ревью не удалось выполнить** (техническая ошибка).\n>\n> Это сбой инфраструктуры, а не замечание к вашей работе. Преподаватель видит такие сбои в логах workflow \`review\` и перезапустит проверку."
