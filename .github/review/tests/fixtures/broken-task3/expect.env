# Ожидания к ИИ-ревью для фикстуры broken-task3.
#
# В работе три намеренных нарушения:
#   1. Файл с синтаксической ошибкой назван bad_syntax.txt вместо error-*
#      (нарушение соглашения курса).
#   2. Грамматика Lang.g4 не содержит ни одного комментария.
#   3. Нет compile.sh — фактически запустить анализатор нельзя.
#
# Хорошее ревью должно указать как минимум на первое и третье.

TASK_NUM=3

DESCRIPTION="Нарушения: нет префикса error-, грамматика без комментариев, нет скрипта запуска"

# Бот обязан упомянуть соглашение об именовании файлов с ошибками.
EXPECT_PRESENT="error-"

# Дополнительные ожидания: хотя бы одно из перечисленного должно быть
# упомянуто. Проверяется отдельно от EXPECT_PRESENT (условие ИЛИ).
EXPECT_ANY_OF="compile.sh|запуск|комментар"

EXPECT_ABSENT="работа принята|ревью пройдено|замечаний не найдено|что сделано хорошо"

MAX_LENGTH_CHARS=9000

# Раздел «Выполненные проверки» обязателен (common-footer.md): таблица с
# результатом по каждому пункту чеклиста вместо похвал.
EXPECT_TABLE="Выполненные проверки"
