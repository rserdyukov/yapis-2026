# Ожидания к ИИ-ревью для фикстуры broken-task4.
#
# Регрессия rublevskaya#8: все примеры зелёные, а бот написал «Замечаний не
# найдено», хотя в анализаторе были дефекты, которые видны только по коду.
# Здесь заложены те же дефекты в уменьшенном виде:
#   1. res-параметр: compiler/mini.py проверяет assignable(ptype, var.type),
#      а для передачи «наружу» нужно assignable(var.type, ptype): m(i) с
#      res float и int i проходит без ошибки.
#   2. Функция с типом int без return принимается (нет проверки путей).
#   3. Вариант — «явное преобразование», а assignable() и README разрешают
#      неявное int → float; оператора приведения (int) x нет вообще.
#   4. error-sem-cast.txt падает на СИНТАКСИСЕ («не разобрано выражение»),
#      а не на семантике.
#   5. error-lex/error-syntax идут по алфавиту рядом с error-sem: check.sh
#      ЛР4 должен запустить все error-sem (лимит и порядок, PR1).
#   6. Папки doc/ нет — для ЛР4 это не замечание.
#
# Хорошее ревью называет хотя бы один дефект кода (1–3), не пишет
# «замечаний не найдено» и не делает doc/ замечанием.

TASK_NUM=4

DESCRIPTION="Зелёный прогон при дефектах семантики: res, return, неявное приведение"

# Хотя бы один из дефектов кода, заметный только при чтении анализатора.
EXPECT_ANY_OF="res|return|неявн|приведени|int → float|int->float|int в float"

EXPECT_ABSENT="замечаний не найдено|работа принята|ревью пройдено|что сделано хорошо|нет (папки|директории|каталога) doc|отсутствует doc"

MAX_LENGTH_CHARS=10000

EXPECT_TABLE="Выполненные проверки"
