# Ожидания к ИИ-ревью для фикстуры good-task1.
#
# Работа корректная: три примера, покрывающие требования варианта.
# Проверяем, что бот не выдумывает несуществующие проблемы и соблюдает
# правила из common-footer.md.

# Номер лабораторной работы (определяет набор промптов tasks/taskN).
TASK_NUM=1

# Краткое описание — печатается в отчёте.
DESCRIPTION="Корректная работа: пример предметной области 71 строка, синтаксический справочник с комментариями, все 14 операций и 3 типа из README"

# Фразы, которых в ревью быть НЕ ДОЛЖНО.
# Здесь ключевое: вердикт запрещён правилами курса — решение принимает
# преподаватель, а не бот. Вторая группа — выдуманные замечания: работа
# намеренно сделана так, что этих проблем в ней нет (example1.txt — 71
# строк, в example2.txt каждая конструкция прокомментирована). Паттерны
# сформулированы так, чтобы не ловить похвалу «удовлетворяет требованию
# "не менее 50 строк"».
EXPECT_ABSENT="работа принята|ревью пройдено|оценка 10|зачтено|не соответствует требованию по объ|недостаточн[а-я]* (объ|строк)|отсутствуют комментарии|нет комментариев|не прокомментирован|что сделано хорошо"

# Позитивные ожидания: на корректной работе резюме обязано сказать, что
# существенных замечаний нет. Мелкие рекомендации (дублирование между
# примерами и т.п.) допустимы. Ищем именно в «Резюме», а не в таблице:
# «Плейсхолдеры | замечаний нет» встречается и в разгромном ревью.
EXPECT_PRESENT="Резюме[:* ]*((существенных )?(замечаний[^.]{0,40}(нет|не найдено)|без замечаний)|(все )?обязательные требования[^.]{0,30}выполнены)"

# Максимальная доля замечаний-выдумок: на корректной работе бот не должен
# писать разгромное ревью. Проверяется косвенно — по длине ответа.
MAX_LENGTH_CHARS=9000

# Раздел «Выполненные проверки» обязателен (common-footer.md): таблица с
# результатом по каждому пункту чеклиста вместо похвал.
EXPECT_TABLE="Выполненные проверки"
