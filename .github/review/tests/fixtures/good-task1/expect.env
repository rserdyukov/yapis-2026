# Ожидания к ИИ-ревью для фикстуры good-task1.
#
# Работа корректная: три примера, покрывающие требования варианта.
# Проверяем, что бот не выдумывает несуществующие проблемы и соблюдает
# правила из common-footer.md.

# Номер лабораторной работы (определяет набор промптов tasks/taskN).
TASK_NUM=1

# Краткое описание — печатается в отчёте.
DESCRIPTION="Корректная работа: 3 примера, покрывают типы, условия, цикл, подпрограмму"

# Слова/фразы, которые ОБЯЗАНЫ встретиться в ревью (регистр игнорируется).
# Через |. Пустое значение — проверка не выполняется.
EXPECT_PRESENT=""

# Фразы, которых в ревью быть НЕ ДОЛЖНО.
# Здесь ключевое: вердикт запрещён правилами курса — решение принимает
# преподаватель, а не бот.
EXPECT_ABSENT="работа принята|ревью пройдено|оценка 10|зачтено"

# Максимальная доля замечаний-выдумок: на корректной работе бот не должен
# писать разгромное ревью. Проверяется косвенно — по длине ответа.
MAX_LENGTH_CHARS=4000
