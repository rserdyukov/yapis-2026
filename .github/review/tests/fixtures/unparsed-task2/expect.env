# Ожидания к ИИ-ревью для фикстуры unparsed-task2.
#
# Грамматика StatLang.g4 собирается без ошибок, но НЕ разбирает собственные
# примеры из examples/: нет лексерного правила для комментариев `//`
# (первая же строка примера даёт «token recognition error») и нет ветки
# `else` в ifStmt. Это воспроизводит реальный случай
# yapis-2026-321702-rublevskaya#2, где модель написала «грамматика полностью
# покрывает функционал», хотя все три примера падали на первой строке.
#
# Хорошее ревью обязано сказать, что примеры не разбираются, и назвать
# причину (комментарии и/или else).

TASK_NUM=2

DESCRIPTION="Грамматика собирается, но не разбирает свои примеры (нет комментариев и else)"

# Бот обязан сообщить, что примеры не проходят через грамматику.
EXPECT_PRESENT="не разбира|не проходит|ошибк"

# И назвать хотя бы одну из причин.
EXPECT_ANY_OF="комментар|else|token recognition"

EXPECT_ABSENT="работа принята|ревью пройдено|замечаний не найдено|полностью покрывает|в полном объ"

MAX_LENGTH_CHARS=8000
