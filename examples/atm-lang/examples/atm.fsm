// Диалог банкомата — эталонная программа на языке FSM.
// Постановка: «Карточка задачи — Диалог банкомата», раздел 1.
// Вывод на сценариях scenarios/*.events совпадает с reference/reference.py.

machine ATM

const PIN: string = "4321"
const MAX_ATTEMPTS: int = 3

context {
  attempts: int   = 0
  balance:  money = 5000
}

events {
  insert_card
  pin(code: string)
  withdraw(amount: money)
  cancel, cash_taken, card_taken, timeout, service
}

states Idle, PinWait, Menu, Dispensing, Ejecting, Captured
initial Idle
terminal Idle

// ------------------------------------------------------------------ действия

action prompt_pin {
  attempts = 0
  say "Введите PIN"
}

action count_attempt {
  attempts = attempts + 1
  say "Неверный PIN. Осталось попыток: ", MAX_ATTEMPTS - attempts
}

action greet        { say "Здравствуйте! Выберите операцию" }
action capture_card { say "Карта изъята" }
action eject_card   { say "Заберите карту" }
action refuse       { say "Недостаточно средств" }
action retract_cash { say "Наличные забраны обратно" }

action dispense(sum: money) {
  balance = balance - sum
  say "Выдано ", sum, " руб. Остаток ", balance, " руб."
}

action reset {
  attempts = 0
  say "Готов к работе"
}

// ------------------------------------------------------------------ переходы
// Переходы одного события проверяются сверху вниз; `else` подтверждает,
// что порядок guard'ов задан намеренно. Нет цели после стрелки — переход в себя.

Idle       -- insert_card ----------------------------------> PinWait    / prompt_pin
Idle       -- pin(_) | withdraw(_) | cancel | cash_taken
            | card_taken | timeout | service                  ignore

PinWait    -- pin(c) [c == PIN] -----------------------------> Menu       / greet
PinWait    -- pin(_) else [attempts + 1 >= MAX_ATTEMPTS] ----> Captured   / capture_card
PinWait    -- pin(_) else ----------------------------------->            / count_attempt
PinWait    -- cancel | timeout ------------------------------> Ejecting   / eject_card
PinWait    -- insert_card | withdraw(_) | cash_taken
            | card_taken | service                            ignore

Menu       -- withdraw(s) [s <= balance] --------------------> Dispensing / dispense(s)
Menu       -- withdraw(_) else ----------------------------->            / refuse
Menu       -- cancel | timeout ------------------------------> Ejecting   / eject_card
Menu       -- insert_card | pin(_) | cash_taken
            | card_taken | service                            ignore

Dispensing -- cash_taken ------------------------------------> Ejecting   / eject_card
Dispensing -- timeout ---------------------------------------> Ejecting   / retract_cash
Dispensing -- insert_card | pin(_) | withdraw(_) | cancel
            | card_taken | service                            ignore

Ejecting   -- card_taken ------------------------------------> Idle       / reset
Ejecting   -- timeout ---------------------------------------> Captured   / capture_card
Ejecting   -- insert_card | pin(_) | withdraw(_) | cancel
            | cash_taken | service                            ignore

Captured   -- service ---------------------------------------> Idle       / reset
Captured   -- insert_card | pin(_) | withdraw(_) | cancel
            | cash_taken | card_taken | timeout               ignore
