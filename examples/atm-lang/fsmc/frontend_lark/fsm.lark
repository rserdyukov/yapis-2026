// Грамматика языка FSM для Lark (LALR(1)).
//
// Это тот же язык, что в grammar/Fsm.g4, записанный средствами другой
// библиотеки. Сравните:
//   * в ANTLR приоритет операций задаётся порядком альтернатив одного
//     левоокурсивного правила `expr`; в LALR-грамматике — лестницей правил
//     or_expr → and_expr → not_expr → cmp_expr → add_expr → mul_expr → unary;
//   * метки альтернатив ANTLR (`# binExpr`) здесь заменяют алиасы (`-> bin`);
//   * `?правило` — правило «прозрачное»: если у него один потомок, узел
//     не создаётся (в ANTLR для этого есть parenExpr + visitParenExpr).
// Парсер не генерируется заранее: Lark строит таблицы LALR при загрузке.

start: "machine" ID decl*

?decl: const_decl
     | context_decl
     | events_decl
     | states_decl
     | initial_decl
     | terminal_decl
     | action_decl
     | transition

// ---------------------------------------------------------------- объявления

const_decl:    "const" ID ":" ID "=" expr
context_decl:  "context" "{" [field (","? field)*] "}"
field:         ID ":" ID ["=" expr]
events_decl:   "events" "{" [event_sig (","? event_sig)*] "}"
event_sig:     ID [PARAMS_OPEN [params] ")"]
params:        param ("," param)*
param:         ID ":" ID
states_decl:   "states" id_list
initial_decl:  "initial" id_list
terminal_decl: "terminal" id_list
id_list:       ID ("," ID)*
action_decl:   "action" ID [PARAMS_OPEN [params] ")"] block

// ---------------------------------------------------------------- переходы

transition: ID DASHES triggers [guard] ARROW ID [calls]   -> move_transition
          | ID DASHES triggers [guard] ARROW calls        -> self_transition
          | ID DASHES triggers "ignore"                   -> ignore_transition

triggers: trigger ("|" trigger)*
trigger:  ID [PARAMS_OPEN [pattern ("," pattern)*] ")"]
pattern:  ID [":" ID]

guard: [ELSE] "[" expr "]"
     | ELSE

calls: "/" call ("," call)*
call:  ID [PARAMS_OPEN [expr ("," expr)*] ")"]

// ---------------------------------------------------------------- операторы

block: "{" stmt* "}"

?stmt: ID "=" expr                         -> assign
     | SAY expr ("," expr)*                -> say
     | if_stmt

if_stmt: IF expr block [ELSE (block | if_stmt)]

// ---------------------------------------------------------------- выражения

?expr: or_expr
?or_expr:  and_expr | or_expr OR and_expr            -> bin
?and_expr: not_expr | and_expr AND not_expr          -> bin
?not_expr: cmp_expr | NOT not_expr                   -> unary
?cmp_expr: add_expr | cmp_expr CMP_OP add_expr       -> bin
?add_expr: mul_expr | add_expr ADD_OP mul_expr       -> bin
?mul_expr: unary    | mul_expr MUL_OP unary          -> bin
?unary:    atom     | MINUS unary                    -> unary
?atom: INT                                           -> int_lit
     | STRING                                        -> str_lit
     | TRUE                                          -> bool_lit
     | FALSE                                         -> bool_lit
     | ID                                            -> ref
     | "(" expr ")"

// ---------------------------------------------------------------- лексика

// Именованные ключевые слова нужны там, где Transformer читает их позицию
// или отличает одно от другого.
SAY: "say"
IF: "if"
ELSE: "else"
OR: "or"
AND: "and"
NOT: "not"
TRUE: "true"
FALSE: "false"
// Скобка «открывает список» — именованный терминал, чтобы Transformer
// отличал `pin()` (пустой список образцов) от `pin` (без скобок).
PARAMS_OPEN: "("

CMP_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"
ADD_OP: "+" | MINUS
MUL_OP: "*" | "/" | "%"
MINUS: "-"

ARROW: /-+>/
DASHES: /--+/

ID: /[^\W\d]\w*/
INT: /[0-9]+/
STRING: /"(?:[^"\\\r\n]|\\["\\n])*"/

COMMENT: /\/\/[^\n]*/
%ignore COMMENT
%ignore /[ \t\r\n]+/
