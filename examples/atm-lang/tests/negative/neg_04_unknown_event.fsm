// Ошибка 4: событие withraw не объявлено (опечатка в withdraw).
// expect: E104 W108
machine Wallet
context { balance: money = 100 }
events { withdraw(amount: money), reset }
states Ready
initial Ready
terminal Ready
action take(sum: money) { balance = balance - sum }
Ready -- withraw(s) [s <= balance] --> / take(s)
Ready -- reset ignore
