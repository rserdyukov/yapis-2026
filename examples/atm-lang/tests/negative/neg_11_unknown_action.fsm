// Ошибка 9 и 10: неизвестное действие и ссылка на несуществующее поле.
// W118: у open в Closed все переходы с guard'ом — компилятор предупреждает.
// expect: E109 E110 W118
machine Door
context { opened: int = 0 }
events { open, close }
states Closed, Opened
initial Closed
terminal Closed
action count { opened = opened + 1 }
Closed -- open  [openned < 10] --> Opened / count
Closed -- close ignore
Opened -- close --> Closed / cuont
Opened -- open  ignore
